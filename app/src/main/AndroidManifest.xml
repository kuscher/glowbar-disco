<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions. Google Play would offer Disco to Googlebooks only: with minSdk 37 the PCs are Googlebooks. -->
    <uses-feature android:name="android.hardware.type.pc" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name">

        <!-- The icon. It opens Glowbar Disco in Glowbar's own window and leaves nothing behind: no window, no task in
             Recents or on the taskbar. Its right-click menu adds the privacy policy (xml/shortcuts.xml). -->
        <activity
            android:name=".DiscoActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
